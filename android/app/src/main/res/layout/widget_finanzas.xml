<?xml version="1.0" encoding="utf-8"?>
<!-- Widget compacto (4x1): balance a la izquierda, botones a la derecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Balance del mes"
            android:textColor="#C9A55A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="S/ 0.00"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_ingresos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:text="↑ —"
                android:textColor="#B9C6DA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_gastos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="↓ —"
                android:textColor="#B9C6DA"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_btn_voz"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_boton_mic"
        android:contentDescription="Dictar movimiento"
        android:scaleType="center"
        android:src="@drawable/widget_icono_mic" />

    <TextView
        android:id="@+id/w_btn_gasto"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_boton_gasto"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="− Gasto"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_btn_ingreso"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_boton_ingreso"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="+ Ingreso"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
